{
  "manifest_version": 3,
  "name": "Foundation — Today",
  "short_name": "Foundation",
  "description": "Form Industries' first stop: each new tab opens Today — the Shiba, what wants you, your goals, and every company app.",
  "version": "0.1.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "Foundation — Today", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
