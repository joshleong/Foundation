# The packaged desktop app (`vite build --mode desktop`, run by `tauri build`).
# Its window is served from http://localhost:31440 by the app itself
# (tauri-plugin-localhost), so a server on localhost is the same site: the
# SameSite=Lax session cookie, the sync WebSocket and SSE all reach it, and the
# server's CORS already admits http://localhost:<port>. Use localhost, not
# 127.0.0.1: cookies are matched by host name.
VITE_FOUNDATION_SERVER=http://localhost:4410
