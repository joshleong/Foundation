# Foundation server — every integration is off until its key is set. See SPEC.md §6.

# FOUNDATION_PORT=4410
# FOUNDATION_DATA_DIR=data
# FOUNDATION_PUBLIC_URL=http://localhost:4410
# FOUNDATION_CLIENT_URL=http://localhost:1430

# who may sign in: emails or @domains
FOUNDATION_ALLOWLIST=@formindustries.com,@normallab.co,josh.leong@gmail.com
FOUNDATION_ADMIN_EMAILS=josh.leong@gmail.com
# dev login (name + allowlisted email, no password) — set 0 on shared servers
FOUNDATION_DEV_LOGIN=1

# Google sign-in (redirect URI: <public url>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# agent: subscription runtime needs only `claude` on PATH; API runtime needs a key
ANTHROPIC_API_KEY=
# FOUNDATION_AGENT_MODEL=claude-opus-5-5
# FOUNDATION_CLAUDE_CLI=claude

# service token for other services/agents (≥ 32 chars)
FOUNDATION_SERVICE_TOKEN=

# search & Hermes
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
FOUNDATION_GITHUB_ORG=

# company connectors
FACTORYFORM_URL=http://127.0.0.1:3001
# BomForm, two ways. Direct (live): its MCP endpoint + key (+ its private CA)
BOMFORM_MCP_URL=
BOMFORM_API_KEY=
# NODE_EXTRA_CA_CERTS=/path/to/bomform-ca.pem
# …or the Airform Data Room's daily copy, read-only (GET /api/foundation/bomform,
# bearer = the Data Room's FOUNDATION_READ_TOKEN). Local: npm run services runs it on :3010
DATAROOM_BOMFORM_URL=
DATAROOM_READ_TOKEN=
DATAROOM_URL=https://airformdata.com
VISION_URL=http://localhost:1420
CREATION_URL=http://localhost:5173
