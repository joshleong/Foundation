{
  "name": "foundation",
  "private": true,
  "description": "Foundation \u2014 the company brain of Form Industries. One grid where people, apps and agents work together.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w @foundation/client",
    "dev:server": "npm run dev -w @foundation/server",
    "build": "npm run build -w @foundation/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "tauri": "npm run tauri -w @foundation/client --",
    "services": "node scripts/sibling.mjs all"
  },
  "engines": {
    "node": ">=22.13"
  }
}
